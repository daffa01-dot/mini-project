generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role              @default(DONATUR)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  namaLengkap      String
  noWhatsapp       String?
  satwaBookmarks   SatwaBookmark[]
  donasi           Donasi[]
  shelter          Shelter?
  shelterBookmarks ShelterBookmark[]
  mailerLogs       MailerLog[]
}

model Shelter {
  id            String            @id @default(uuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  userId        String            @unique
  alamatLengkap String
  status        Status            @default(MENUNGGU)
  deskripsi     String
  fotoBanner    String?
  isAktif       Boolean           @default(true)
  kota          String
  namaShelter   String
  noWhatsapp    String
  donasi        Donasi[]
  satwa         Satwa[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rekening      ShelterBank?
  bookmarks     ShelterBookmark[]
}

model ShelterBank {
  id               String   @id @default(uuid())
  shelterId        String   @unique
  namaBank         String
  nomorRekening    String
  atasNamaRekening String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  shelter          Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model Satwa {
  id            String          @id @default(uuid())
  shelterId     String
  nama          String
  jenis         JenisSatwa
  ras           String?
  umur          Int
  kelamin       KelaminSatwa
  foto          String?
  deskripsi     String?
  danaTerkumpul Int             @default(0)
  status        StatusSatwa     @default(TERSEDIA)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  bookmarks     SatwaBookmark[]
  donasi        Donasi[]
  laporan       Laporan[]
  shelter       Shelter         @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model Donasi {
  id             String    @id @default(uuid())
  donaturId      String
  satwaId        String?
  shelterId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  buktiResi      String
  catatan        String?
  nominal        Int
  status         Status    @default(MENUNGGU)
  alasanDitolak  String?
  diverifikasiAt DateTime?
  donatur        User      @relation(fields: [donaturId], references: [id])
  satwa          Satwa?    @relation(fields: [satwaId], references: [id])
  shelter        Shelter   @relation(fields: [shelterId], references: [id])
}

model Laporan {
  id           String    @id @default(uuid())
  satwaId      String
  judul        String
  deskripsi    String
  foto         String?
  fotoPublicId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  satwa        Satwa     @relation(fields: [satwaId], references: [id], onDelete: Cascade)
}

model MailerLog {
  id            String               @id @default(uuid())
  userId        String?              @map("user_id")
  emailTo       String               @map("email_to") @db.VarChar(150)
  subject       String               @db.VarChar(255)
  body          String
  referenceId   String?              @map("reference_id")
  sentAt        DateTime?            @map("sent_at")
  errorMessage  String?              @map("error_message")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deleted_at    DateTime?
  type          MailerLogType
  referenceType MailerReferenceType? @map("reference_type")
  status        MailerStatus         @default(pending)
  user          User?                @relation(fields: [userId], references: [id])

  @@map("mailer_logs")
}

model SatwaBookmark {
  id        String   @id @default(uuid())
  userId    String
  satwaId   String
  createdAt DateTime @default(now())
  satwa     Satwa    @relation(fields: [satwaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, satwaId])
  @@map("satwa_Bookmark")
}

model ShelterBookmark {
  id        String   @id @default(uuid())
  userId    String
  shelterId String
  createdAt DateTime @default(now())
  shelter   Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shelterId])
}

enum Role {
  SUPER_ADMIN
  SHELTER
  DONATUR
}

enum JenisSatwa {
  ANJING
  KUCING
  LAINNYA
}

enum KelaminSatwa {
  JANTAN
  BETINA
}

enum StatusSatwa {
  TERSEDIA
  DIADOPSI
  TIDAK_AKTIF
}

enum Status {
  MENUNGGU
  DIVERIFIKASI
  DITOLAK
}

enum MailerLogType {
  donasi_berhasil
  donasi_gagal
}

enum MailerReferenceType {
  donasi
}

enum MailerStatus {
  pending
  success
  failed
}

<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Donation Receipt - TEMAN ASUH</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f8f9ff",
                        "secondary": "#545f73",
                        "on-surface-variant": "#3d4a3d",
                        "on-error": "#ffffff",
                        "secondary-fixed-dim": "#bcc7de",
                        "error": "#ba1a1a",
                        "inverse-on-surface": "#eaf1ff",
                        "on-surface": "#0b1c30",
                        "tertiary": "#55615a",
                        "primary-container": "#22c55e",
                        "surface-container-low": "#eff4ff",
                        "on-tertiary-fixed": "#131e19",
                        "on-secondary": "#ffffff",
                        "tertiary-fixed-dim": "#bdcac1",
                        "on-error-container": "#93000a",
                        "surface-container": "#e5eeff",
                        "surface-container-highest": "#d3e4fe",
                        "on-secondary-fixed-variant": "#3c475a",
                        "surface-container-high": "#dce9ff",
                        "outline-variant": "#bccbb9",
                        "on-primary": "#ffffff",
                        "on-background": "#0b1c30",
                        "background": "#f8f9ff",
                        "primary-fixed": "#6bff8f",
                        "on-primary-fixed-variant": "#005321",
                        "surface": "#f8f9ff",
                        "surface-tint": "#006e2f",
                        "outline": "#6d7b6c",
                        "on-primary-fixed": "#002109",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed-variant": "#3e4943",
                        "primary-fixed-dim": "#4ae176",
                        "inverse-surface": "#213145",
                        "tertiary-fixed": "#d9e6dd",
                        "on-primary-container": "#004b1e",
                        "error-container": "#ffdad6",
                        "primary": "#006e2f",
                        "inverse-primary": "#4ae176",
                        "on-tertiary-container": "#37433c",
                        "tertiary-container": "#a2afa7",
                        "surface-variant": "#d3e4fe",
                        "secondary-container": "#d5e0f8",
                        "on-secondary-fixed": "#111c2d",
                        "on-secondary-container": "#586377",
                        "surface-dim": "#cbdbf5",
                        "secondary-fixed": "#d8e3fb"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "section-padding": "2.5rem",
                        "container-max": "800px",
                        "gutter": "1rem",
                        "mobile-margin": "1rem",
                        "stack-gap": "1.5rem"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "detail-xs": ["Inter"],
                        "label-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "display-lg-mobile": ["Inter"],
                        "body-lg": ["Inter"],
                        "display-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "detail-xs": ["12px", {"lineHeight": "16px", "fontWeight": "400"}],
                        "label-sm": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "display-lg-mobile": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "display-lg": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-print-color-adjust: exact;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        @media print {
            .no-print { display: none !important; }
            .print-shadow { box-shadow: none !important; border: 1px solid #e2e8f0 !important; }
            body { background: white !important; }
        }
    </style>
</head>
<body class="bg-surface-bright min-h-screen">
<header class="bg-surface dark:bg-surface-dim border-b border-outline-variant dark:border-outline no-print">
<div class="flex justify-between items-center w-full px-mobile-margin md:px-section-padding max-w-container-max mx-auto h-16">
<div class="flex items-center gap-2">
<span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">TEMAN ASUH</span>
</div>
<div class="flex gap-4">
<button class="material-symbols-outlined text-primary dark:text-primary-fixed-dim hover:bg-surface-container-high dark:hover:bg-surface-container-highest transition-colors p-2 rounded-full cursor-pointer active:scale-95" onclick="window.print()">print</button>
</div>
</div>
</header>
<main class="py-12 px-mobile-margin">
<div class="max-w-container-max mx-auto bg-white rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.05)] overflow-hidden print-shadow">
<div class="p-8 md:p-12 border-b border-outline-variant flex flex-col items-center text-center">
<h1 class="font-display-lg text-display-lg text-on-surface mb-2">Donation Receipt</h1>
<p class="font-body-lg text-body-lg text-primary font-medium">Donasi Anda telah berhasil diverifikasi.</p>
<div class="mt-4 flex items-center gap-2 px-3 py-1 bg-primary-container/10 text-primary rounded-full">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<span class="font-label-sm text-label-sm uppercase tracking-wider">Verified Transaction</span>
</div>
</div>
<div class="p-8 md:p-12 space-y-12">
<!-- Section 1: Donation Metadata -->
<section>
<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
<div>
<p class="font-label-sm text-label-sm text-secondary uppercase tracking-tight mb-1">Donation ID</p>
<p class="font-body-md text-body-md text-on-surface font-semibold">{{ donasiId }}</p>
</div>
<div>
<p class="font-label-sm text-label-sm text-secondary uppercase tracking-tight mb-1">Verification Date</p>
<p class="font-body-md text-body-md text-on-surface">{{ tanggal }}</p>
</div>
<div>
<p class="font-label-sm text-label-sm text-secondary uppercase tracking-tight mb-1">Status</p>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary text-white">DIVERIFIKASI</span>
</div>
</div>
</section>
<hr class="border-outline-variant">
<!-- Section 2 & 3: Personal & Shelter Info -->
<section class="grid md:grid-cols-2 gap-12">
<div class="space-y-4">
<h3 class="font-label-sm text-label-sm text-secondary uppercase font-bold border-b border-outline-variant pb-2">Informasi Donatur</h3>
<div>
<p class="font-detail-xs text-detail-xs text-secondary uppercase mb-1">Nama Lengkap</p>
<p class="font-body-md text-body-md font-semibold text-on-surface">{{ name }}</p>
</div>
</div>
<div class="space-y-4">
<h3 class="font-label-sm text-label-sm text-secondary uppercase font-bold border-b border-outline-variant pb-2">Detail Shelter</h3>
<div>
<p class="font-detail-xs text-detail-xs text-secondary uppercase mb-1">Nama Shelter</p>
<p class="font-body-md text-body-md font-semibold text-on-surface">{{ namaShelter }}</p>
</div>
</div>
</section>

<!-- Section 5: Donation Details -->
<section class="space-y-6">
<div class="bg-surface-container-low p-8 rounded-lg text-center">
<p class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-2">Total Donation Amount</p>
<p class="font-display-lg text-display-lg text-on-surface font-bold text-4xl">{{ nominal }}</p>
</div>
</section>
</div>
<div class="bg-surface-container-highest p-8 text-center">
<p class="font-body-md text-body-md text-secondary max-w-md mx-auto">
    Terima kasih banyak atas kebaikan hati Anda membantu satwa melalui TEMAN ASUH.
</p>
</div>
</div>
</main>
</body></html>

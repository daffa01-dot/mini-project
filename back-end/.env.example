# PostgreSQL connection strings used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

PORT=8001
WHITE_LIST="http://localhost:3000,https://temanasuh-ui.vercel.app"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
JWT_SECRET_VERIFICATION_KEY="replace-with-a-different-long-random-secret"
JWT_VERIFICATION_EXPIRES_IN="1h"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NODEMAILER_GOOGLE_APP_USER_EMAIL=""
NODEMAILER_GOOGLE_APP_PASSWORD=""

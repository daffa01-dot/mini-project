generator client {
  provider = "prisma-client-js"
  OUTPUT = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  password    String
  role        Role        @default(DONATUR)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  namaLengkap String
  noWhatsapp  String?
  donasi      Donasi[]
  shelter     Shelter?
  mailerLogs  MailerLog[] 
  bookmarks   Bookmark[]  
}

model Shelter {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?    
  userId        String       @unique
  alamatLengkap String
  deskripsi     String
  fotoBanner    String?
  isAktif       Boolean      @default(true)
  kota          String
  namaShelter   String
  noWhatsapp    String
  donasi        Donasi[]
  satwa         Satwa[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rekening      ShelterBank[] // 🟢 Tambahan: Relasi ke tabel bank baru (Tabel ke-7)
}

// 🟢 TABEL KE-7: Untuk memisahkan data rekening shelter 
model ShelterBank {
  id                String   @id @default(uuid())
  shelterId         String   
  namaBank          String
  nomorRekening     String
  atasNamaRekening  String
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt // 🟢 Tambahkan @default(now())
  deletedAt         DateTime?

  shelter           Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  @@index([shelterId])
}
model Satwa {
  id            String       @id @default(uuid())
  shelterId     String
  nama          String
  jenis         JenisSatwa
  ras           String?
  umur          Int
  kelamin       KelaminSatwa
  foto          String?
  deskripsi     String?
  riwayatMedis  String?
  danaTerkumpul Int          @default(0)
  status        StatusSatwa  @default(TERSEDIA)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?    
  donasi        Donasi[]
  laporan       Laporan[]
  shelter       Shelter      @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  bookmarks     Bookmark[]   
}


model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  satwaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  satwa     Satwa    @relation(fields: [satwaId], references: [id], onDelete: Cascade)

  @@unique([userId, satwaId]) 
}

model Donasi {
  id             String       @id @default(uuid())
  donaturId      String
  satwaId        String?
  shelterId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  buktiResi      String
  buktiResiPublic String? 
  catatan        String?
  nominal        Int

  status         StatusDonasi @default(MENUNGGU)
  alasanDitolak  String?
  diverifikasiAt DateTime?

  donatur User    @relation(fields: [donaturId], references: [id], onDelete: Restrict)
  satwa   Satwa?  @relation(fields: [satwaId], references: [id], onDelete: SetNull)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Restrict)
}

model Laporan {
  id        String    @id @default(uuid())
  satwaId   String
  judul     String
  deskripsi String
  foto      String?
  fotoPublicId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 
  satwa     Satwa     @relation(fields: [satwaId], references: [id], onDelete: Cascade)
}

model MailerLog {
  id            String               @id @default(uuid())
  userId        String?              @map("user_id")
  emailTo       String               @map("email_to") @db.VarChar(150)
  subject       String               @db.VarChar(255)
  body          String
  referenceId   String?              @map("reference_id")
  sentAt        DateTime?            @map("sent_at")
  errorMessage  String?              @map("error_message")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deleted_at    DateTime?
  type          MailerLogType
  referenceType MailerReferenceType? @map("reference_type")
  status        MailerStatus         @default(pending)
  user          User?                @relation(fields: [userId], references: [id])

  @@map("mailer_logs")
}

enum Role {
  SUPER_ADMIN
  SHELTER
  DONATUR
}

enum JenisSatwa {
  ANJING
  KUCING
  LAINNYA
}

enum KelaminSatwa {
  JANTAN
  BETINA
}

enum StatusSatwa {
  TERSEDIA
  DIADOPSI
  TIDAK_AKTIF
}

enum StatusDonasi {
  MENUNGGU
  DIVERIFIKASI
  DITOLAK
}

enum MailerLogType {
  donasi_berhasil
  donasi_gagal
}

enum MailerReferenceType {
  donasi
}

enum MailerStatus {
  pending
  success
  failed
}
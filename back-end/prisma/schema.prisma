generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        Role     @default(DONATUR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  namaLengkap String
  noWhatsapp  String?
  donasi      Donasi[]
  shelter     Shelter?
}

model Shelter {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  alamatLengkap    String
  atasNamaRekening String
  deskripsi        String
  fotoBanner       String?
  isAktif          Boolean  @default(true)
  kota             String
  namaBank         String
  namaShelter      String
  noWhatsapp       String
  nomorRekening    String
  donasi           Donasi[]
  satwa            Satwa[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Satwa {
  id           String       @id @default(uuid())
  shelterId    String
  nama         String
  jenis        JenisSatwa
  ras          String?
  umur         Int
  kelamin      KelaminSatwa
  foto         String?
  deskripsi    String?
  riwayatMedis String?
  status       StatusSatwa  @default(TERSEDIA)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  donasi       Donasi[]
  laporan      Laporan[]
  shelter      Shelter      @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model Donasi {
  id             String       @id @default(uuid())
  donaturId      String
  satwaId        String?      // Dibikin opsional agar jika data satwa dihapus, rekam jejak donasi tetap aman
  shelterId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  buktiResi      String       // Pada endpoint awal diisi string kosong "", diupdate setelah upload file
  catatan        String?
  nominal        Int
  status         StatusDonasi @default(MENUNGGU)
  
  // Tambahan Fitur Keamanan Keuangan & Audit Trail 🛡️
  alasanDitolak  String?      // Wajib diisi oleh Shelter jika status berubah menjadi DITOLAK
  diverifikasiAt DateTime?    // Mengetahui kapan waktu pasti shelter menyetujui/menolak donasi ini

  // Pengamanan Integritas Relasi (OnDelete Actions)
  donatur        User         @relation(fields: [donaturId], references: [id], onDelete: Restrict)
  satwa          Satwa?       @relation(fields: [satwaId], references: [id], onDelete: SetNull)
  shelter        Shelter      @relation(fields: [shelterId], references: [id], onDelete: Restrict)
}

model Laporan {
  id        String   @id @default(uuid())
  satwaId   String
  judul     String
  deskripsi String
  foto      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  satwa     Satwa    @relation(fields: [satwaId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  SHELTER
  DONATUR
}

enum JenisSatwa {
  ANJING
  KUCING
  LAINNYA
}

enum KelaminSatwa {
  JANTAN
  BETINA
}

enum StatusSatwa {
  TERSEDIA
  DIADOPSI
  TIDAK_AKTIF
}

enum StatusDonasi {
  MENUNGGU
  DIVERIFIKASI
  DITOLAK
}